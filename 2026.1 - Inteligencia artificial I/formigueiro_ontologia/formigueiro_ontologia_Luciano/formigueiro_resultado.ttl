ex:OntologiaFormigueiro a owl:Ontology ;
    rdfs:comment "Ontologia que modela um sistema multiagente com comunicação indireta (estigmergia via feromônios positivos e negativos)." .

ex:Predador01 a ex:Tamandua ;
    ex:contadorPredadas 0 ;
    ex:intervaloMovimentoSegundos 5 .

ex:apontaPara a owl:ObjectProperty ;
    rdfs:comment "Indica o próximo nó na trilha do feromônio positivo." ;
    rdfs:domain ex:Feromonio ;
    rdfs:range ex:No .

ex:capacidadeMaxima a owl:DatatypeProperty ;
    rdfs:domain ex:Alimento ;
    rdfs:range xsd:integer .

ex:compostaPor a owl:ObjectProperty ;
    rdfs:domain ex:Rota ;
    rdfs:range ex:No .

ex:contadorPredadas a owl:DatatypeProperty ;
    rdfs:domain ex:Tamandua ;
    rdfs:range xsd:integer .

ex:contadorSucesso a owl:DatatypeProperty ;
    rdfs:domain ex:Alimento ;
    rdfs:range xsd:integer .

ex:coordX a owl:DatatypeProperty ;
    rdfs:domain ex:No ;
    rdfs:range xsd:integer .

ex:coordY a owl:DatatypeProperty ;
    rdfs:domain ex:No ;
    rdfs:range xsd:integer .

ex:deposita a owl:ObjectProperty ;
    rdfs:domain ex:Formiga ;
    rdfs:range ex:Feromonio .

ex:elimina a owl:ObjectProperty ;
    rdfs:domain ex:Tamandua ;
    rdfs:range ex:Formiga .

ex:ignoraLimiteEnergia a owl:DatatypeProperty ;
    rdfs:comment "Regra: Se Verdadeiro, a formiga ignora o ex:limitePassos enquanto estiver seguindo um ex:Feromonio do tipo 'positivo'." ;
    rdfs:domain ex:Formiga ;
    rdfs:range xsd:boolean .

ex:impregnadoEm a owl:ObjectProperty ;
    rdfs:domain ex:Feromonio ;
    rdfs:range ex:No .

ex:intervaloMovimentoSegundos a owl:DatatypeProperty ;
    rdfs:domain ex:Tamandua ;
    rdfs:range xsd:integer .

ex:limitePassos a owl:DatatypeProperty ;
    rdfs:domain ex:Formiga ;
    rdfs:range xsd:integer .

ex:monitora a owl:ObjectProperty ;
    rdfs:domain ex:Orquestrador ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ex:Alimento ex:Tamandua ex:Formigueiro ) ] .

ex:percorre a owl:ObjectProperty ;
    rdfs:domain ex:Formiga ;
    rdfs:range ex:Rota .

ex:populacaoTotal a owl:DatatypeProperty ;
    rdfs:domain ex:Formigueiro ;
    rdfs:range xsd:integer .

ex:posicionadoEm a owl:ObjectProperty ;
    rdfs:domain ex:Entidade ;
    rdfs:range ex:No .

ex:rotaValida a owl:DatatypeProperty ;
    rdfs:comment "Indica se a rota levou ao alimento (true) ou foi falha (false)." ;
    rdfs:domain ex:Rota ;
    rdfs:range xsd:boolean .

ex:tipoFeromonio a owl:DatatypeProperty ;
    rdfs:comment "Pode ser 'nogood' (negativo) ou 'positivo'." ;
    rdfs:domain ex:Feromonio ;
    rdfs:range xsd:string .

