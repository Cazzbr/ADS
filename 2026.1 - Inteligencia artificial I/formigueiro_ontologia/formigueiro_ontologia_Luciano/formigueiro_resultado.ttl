    ex:capacidadeMaxima 4 ;
    ex:contadorSucesso 4 .

ex:Ambiente a owl:Class .

ex:BaseFormigueiro a ex:Formigueiro ;
    ex:populacaoTotal 5 ;
    ex:posicionadoEm ex:NoOrigem .

